# Env for database connection
# DATABASE_URL="postgresql://postgres:{YOUR_PASSWORD}@localhost:5432/habits_tracker_db?schema=public"
DATABASE_URL=
# Set to "neon" when using Neon serverless PostgreSQL
DB_ADAPTER=

# Env for Express server
# PORT=3000
PORT=
# Comma-separated allowed browser origins (defaults to local + Vercel + habits.krakenserv.dev)
CORS_ORIGINS=
# Comma-separated trusted reverse-proxy CIDRs/IPs for rate limiting
TRUSTED_PROXY_CIDRS=

# JWT secret for auth (32+ chars required in production)
JWT_SECRET=
# Password recovery (omit all three settings to disable it)
SMTP_URL=
PASSWORD_RESET_FROM=
PUBLIC_APP_URL=
